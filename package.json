{
  "name": "medium-digest",
  "version": "0.1.0",
  "private": true,
  "description": "A daily Medium digest as a scheduled job: medium-reader-mcp fetches and keeps state, a model shortlists and reads posts through an OpenAI-compatible gateway, and the result goes to a Discord webhook",
  "license": "MIT",
  "author": "Bill Baran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkbaran/medium-digest.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dry-run": "node dist/main.js --dry-run"
  },
  "dependencies": {
    "cron-llm": "^0.2.0",
    "medium-reader-mcp": "^0.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
