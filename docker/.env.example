# Copy to docker/.env (gitignored) and fill in.

# Host directories (absolute paths on the Docker host).
DIGEST_DIR=/srv/medium-digest/state
AUTH_DIR=/srv/medium-digest/auth

# Time zone for the crontab and for dates in the digest (passed to the server too).
TZ=UTC

# Any OpenAI-compatible gateway (a LiteLLM proxy, Ollama, OpenAI).
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=
# "none" turns Qwen's thinking off on Ollama.
LLM_REASONING_EFFORT=none

# Where the digest goes, and where failure notices go (defaults to the same webhook).
DISCORD_WEBHOOK_URL=
DISCORD_FAILURE_WEBHOOK_URL=

# medium-reader-mcp settings; every MEDIUM_READER_* variable is passed to the server.
# A job waits as long as digest_begin needs; the server's default (170s) is sized for agent hosts.
MEDIUM_READER_DIGEST_FETCH_BUDGET=10min
# The headline classifier. "sampling" needs an agent host, so a job uses jev (or off).
MEDIUM_READER_CLASSIFIER=jev
MEDIUM_READER_JEV_URL=
MEDIUM_READER_JEV_MODEL=
MEDIUM_READER_JEV_API_KEY=
# MEDIUM_READER_DIGEST_RANK_FLOOR=0.5
# Lengths and ⭐ count digest_finish keeps; the job's prompts ask for the same (defaults 280, 400, 250, 8).
# MEDIUM_READER_DIGEST_GIST_MAX=280
# MEDIUM_READER_DIGEST_STAR_GIST_MAX=400
# MEDIUM_READER_DIGEST_WHY_MAX=250
# MEDIUM_READER_DIGEST_MAX_STARRED=8
# How many headlines may be shortlisted (default 10, 5, 10, and 3 per publication in Following).
# SHORTLIST_FOLLOWING=10
# SHORTLIST_TOP_PICKS=5
# SHORTLIST_FOR_YOU=10
# SHORTLIST_PER_PUBLICATION=3
# MEDIUM_READER_DIGEST_RANK_FLOOR_MODE=exclude
